# Local-only values; never use these in staging or production.
POSTGRES_BOOTSTRAP_PASSWORD=local_bootstrap_only_change_me
DATABASE_PASSWORD=local_app_only_change_me
TEAM_API_KEYS=local-dev=local-dev-token
ADMIN_API_KEYS=local-dev=local-dev-token
WEBHOOK_SECRET=local-webhook-secret-change-me
GIT_ACCESS_TOKEN=
GIT_ALLOWED_HOSTS=github.com
MCP_ALLOWED_ORIGINS=http://localhost,http://127.0.0.1
EMBEDDING_MODEL=qwen3-embedding:0.6b
GRAPHIFY_OLLAMA_MODEL=qwen3:0.6b
EMBEDDING_DIMENSIONS=1024
GRAPHIFY_ENABLED=true
MAX_INDEX_CONCURRENCY=2
GIT_TIMEOUT_SECONDS=300
